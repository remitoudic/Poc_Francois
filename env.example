# Plunet BusinessManager API Configuration
PLUNET_BASE_URL=https://portal.foxtranslations.com/
PLUNET_USERNAME=your_username
PLUNET_PASSWORD=your_password
# soap = live portal, fake = in-memory Plunet for local development
PLUNET_MODE=soap

# PostgreSQL Database Configuration
POSTGRES_USER=fox_user
POSTGRES_PASSWORD=fox_password
POSTGRES_DB=fox_mlo
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://fox_user:fox_password@postgres:5432/fox_mlo

# Destination Server
DEFAULT_DESTINATION_URL=http://api:8000/api/v1/etl/simulate-destination

# Temporal (workflow engine)
TEMPORAL_NAMESPACE=fox-mlo
TEMPORAL_UI_HOST_PORT=8088

# Polylang / WordPress source (defaults to the bundled mock)
POLYLANG_BASE_URL=http://polylang-mock:8090
POLYLANG_USERNAME=
POLYLANG_APP_PASSWORD=
# Site name shown in the app (default: the host of POLYLANG_BASE_URL); the mock site is maison-lumiere.com
POLYLANG_SITE=

# Plunet sync interval in seconds (polling is the only sync path)
PLUNET_SYNC_SECONDS=120
# /api/v1/dev endpoints for local testing; never true in production
DEV_ENDPOINTS=false
